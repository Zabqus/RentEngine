# Skopiuj do .env i uzupełnij wartości
DB_NAME=rentengine
DB_USER=rentengine
DB_PASSWORD=change_me
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/rentengine

# Min. 32 znaki (HS256)
JWT_SECRET=change_me_to_random_string_at_least_32_chars
# Czas ważności tokena (ISO-8601), domyślnie PT24H
JWT_EXPIRATION=PT24H

# Katalog na zdjęcia uszkodzeń (opcjonalnie), domyślnie backend/uploads
# UPLOADS_DIR=uploads

# Cena litra paliwa za braki przy zwrocie (opcjonalnie), domyślnie 7.00
# FUEL_PRICE=7.00
