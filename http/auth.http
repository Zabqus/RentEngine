# Konta z seeda (V7): client / client2 / employee / admin @rentengine.local
# Każde logowanie zapisuje token swojej roli ({{clientToken}}, {{adminToken}}...), którego używają pozostałe pliki .http

### Logowanie jako klient (Jan Kowalski)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "client@rentengine.local",
  "password": "Client123!"
}

> {% client.global.set("clientToken", response.body.accessToken); %}

### Logowanie jako drugi klient (Anna Nowak)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "client2@rentengine.local",
  "password": "Client123!"
}

> {% client.global.set("client2Token", response.body.accessToken); %}

### Logowanie jako pracownik
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "employee@rentengine.local",
  "password": "Employee123!"
}

> {% client.global.set("employeeToken", response.body.accessToken); %}

### Logowanie jako admin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@rentengine.local",
  "password": "Admin123!"
}

> {% client.global.set("adminToken", response.body.accessToken); %}

### Złe hasło → 401
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@rentengine.local",
  "password": "wrong"
}

### Rejestracja nowego klienta → 201 + token (zmień email przy kolejnym uruchomieniu)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "nowy.klient@example.com",
  "password": "Haslo1234",
  "firstName": "Ola",
  "lastName": "Nowicka"
}

### Zajęty email → 409 EMAIL_TAKEN
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "client@rentengine.local",
  "password": "Haslo1234",
  "firstName": "Jan",
  "lastName": "Kowalski"
}

### Błędy walidacji → 400
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "short",
  "firstName": "",
  "lastName": "X"
}
